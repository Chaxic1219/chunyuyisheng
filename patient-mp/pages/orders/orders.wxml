<view class="page">
  <view class="head">
    <text class="head-title">我的服务</text>
  </view>

  <view wx:if="{{loading}}" class="empty">正在加载…</view>
  <view wx:elif="{{error}}" class="empty pressable" bindtap="load">{{error}}，点击重试</view>

  <block wx:else>
    <view wx:if="{{orders.length === 0}}" class="empty">
      <text>暂无服务订单</text>
      <button class="btn-soft empty-btn" bindtap="goServices">去逛逛健康服务</button>
    </view>

    <view wx:for="{{orders}}" wx:key="id" class="card order" data-id="{{item.id}}" bindtap="onOrderTap">
      <view class="order-top">
        <text class="order-title">{{item.title || '健康服务'}}</text>
        <text class="order-status {{item.status === 'paid_pending_profile' || item.status === 'active' ? 'st-ok' : ''}}">{{item.statusLabel}}</text>
      </view>
      <view class="order-row">
        <text class="order-label">订单号</text>
        <text class="order-value">{{item.orderNo}}</text>
      </view>
      <view class="order-row">
        <text class="order-label">下单时间</text>
        <text class="order-value">{{item.createdAtLabel}}</text>
      </view>
      <view class="order-foot">
        <text class="amount">¥{{item.amountLabel}}</text>
        <text wx:if="{{item.status === 'pending_payment'}}" class="order-pay">去支付 ›</text>
      </view>
    </view>
  </block>
</view>
