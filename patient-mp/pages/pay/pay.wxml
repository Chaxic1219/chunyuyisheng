<view class="pay-page">
  <view wx:if="{{loading}}" class="empty">正在发起支付…</view>

  <view wx:elif="{{error && !mockMode}}" class="pay-card error-card">
    <text class="error-title">支付未完成</text>
    <text class="error-sub">{{error}}</text>
    <button class="btn-primary pay-btn" bindtap="onRetry">重新发起支付</button>
    <button class="btn-soft pay-btn" bindtap="goResult">查看订单状态</button>
  </view>

  <!-- 仿真微信收银台（mock 模式） -->
  <block wx:elif="{{mockMode}}">
    <view class="cashier">
      <view class="cashier-brand">
        <view class="wechat-badge">支付</view>
        <text class="cashier-title">收银台</text>
      </view>
      <view class="cashier-amount">
        <text class="cashier-cny">¥</text>
        <text class="cashier-num">{{amountLabel}}</text>
      </view>
      <view class="cashier-desc">春雨医患通 · 健康服务</view>

      <view class="cashier-body">
        <view class="cashier-row">
          <text class="row-label">商品</text>
          <text class="row-value">{{order.title || '健康服务'}}</text>
        </view>
        <view class="cashier-row">
          <text class="row-label">订单号</text>
          <text class="row-value">{{order.orderNo || orderId}}</text>
        </view>
        <view class="cashier-row">
          <text class="row-label">支付方式</text>
          <text class="row-value">微信支付</text>
        </view>
      </view>

      <view class="cashier-note">开发态演示收银台 · 不会发起真实扣款</view>

      <button class="btn-primary cashier-confirm" disabled="{{paying}}" bindtap="onMockConfirm">
        {{paying ? '支付中…' : '确认支付 ¥' + amountLabel}}
      </button>
      <view class="cashier-cancel" bindtap="onMockCancel">暂不支付</view>
    </view>
  </block>

  <!-- 真实微信支付模式：调用 wx.requestPayment，无需页面交互 -->
  <view wx:else class="empty">已拉起微信支付，请稍候…</view>
</view>
