.result-page {
  padding-top: 80rpx;
}

.result-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 40rpx;
  text-align: center;
}

.icon-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 120rpx;
  text-align: center;
}

.icon-ok {
  background: #e8f5ee;
  color: #07c160;
}

.icon-wait {
  background: #f0f2f4;
  color: #8a938d;
}

.result-title {
  margin-top: 28rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: #17201c;
}

.result-amount {
  margin-top: 12rpx;
  font-size: 32rpx;
  color: #6a756f;
}

.result-hint {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #8a938d;
}

.result-btn {
  margin-top: 24rpx;
}
