.head {
  padding: 16rpx 8rpx 32rpx;
}

.head-title {
  display: block;
  font-size: 48rpx;
  font-weight: 800;
  color: #17201c;
}

.head-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #6a756f;
}

.product-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.product-title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 700;
  color: #17201c;
}

.product-amount {
  font-size: 34rpx;
}

.product-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #6a756f;
}

.product-doctor {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8a938d;
}

.product-foot {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
}

.tag {
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  background: #eef4f0;
  color: #176b52;
  font-size: 22rpx;
}

.buy {
  margin-left: auto;
  color: #176b52;
  font-size: 26rpx;
  font-weight: 600;
}

.pressable:active {
  opacity: 0.7;
}
