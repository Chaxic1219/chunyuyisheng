<view class="tab-bar {{elder ? 'tab-bar--elder' : ''}} {{reducedMotion ? 'tab-bar--reduced-motion' : ''}}">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab-bar__item {{selected === index ? 'is-active' : ''}}"
    data-index="{{index}}"
    data-path="{{item.pagePath}}"
    bindtap="onSwitch"
  >
    <image
      class="tab-bar__icon"
      src="{{selected === index ? item.selectedIconPath : item.iconPath}}"
      mode="aspectFit"
    />
    <text
      class="tab-bar__text"
      style="color: {{selected === index ? selectedColor : color}}"
    >{{item.text}}</text>
  </view>
</view>
