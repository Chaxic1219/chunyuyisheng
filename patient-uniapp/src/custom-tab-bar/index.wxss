.tab-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 999;
  display: flex;
  box-sizing: border-box;
  height: calc(72px + env(safe-area-inset-bottom));
  padding: 7px 20px calc(7px + env(safe-area-inset-bottom));
  border-top: 1px solid #edf0ee;
  background: rgba(255, 255, 255, 0.98);
}

.tab-bar__item {
  display: flex;
  min-width: 0;
  min-height: 56px;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3px;
}

.tab-bar__icon {
  display: block;
  width: 27px;
  height: 27px;
  transition: opacity 140ms ease-out, transform 140ms ease-out;
}

.tab-bar__text {
  color: #858c88;
  font-size: 14px;
  font-weight: 500;
  line-height: 19px;
}

.tab-bar__item.is-active .tab-bar__text {
  font-weight: 600;
}

.tab-bar__item:active .tab-bar__icon {
  opacity: 0.86;
  transform: scale(0.97);
}

.tab-bar--reduced-motion .tab-bar__icon,
.tab-bar--reduced-motion .tab-bar__item:active .tab-bar__icon {
  transform: none;
}

.tab-bar--elder {
  height: calc(82px + env(safe-area-inset-bottom));
}

.tab-bar--elder .tab-bar__icon {
  width: 32px;
  height: 32px;
}

.tab-bar--elder .tab-bar__text {
  font-size: 17px;
  line-height: 22px;
}
