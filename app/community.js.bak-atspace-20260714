  }
  return db.prepare(`SELECT * FROM knowledge_items WHERE doctor_id=? AND status='ready'
    ORDER BY CASE layer WHEN '医生个人' THEN 1 WHEN '医院/科室通用' THEN 2 WHEN '医院通用' THEN 3 ELSE 4 END, id DESC LIMIT 3`).all(did);
}

function createOpsContentCandidate(input){
  const did = resolveDoctorId(input);
  if(!did) throw new Error("医生不存在或缺少 doctorId/doctorSlug");
  const group = findGroup(did, input);
  if(!group) throw new Error("群配置不存在");
  if(group.status === "paused" || group.review_mode === "paused") throw new Error("群已暂停，不能生成运营内容");
  const items = readyKnowledgeForCandidate(did, input);
  if(!items.length) throw new Error("缺少已审核知识源：请先把 knowledge_items 标记为 ready，再生成候选内容");
  const { doctor } = doctorContent(did);
  const topic = cleanText(input && input.topic, 90) || cleanText(items[0].title, 90);
  const evidence = items.map(x=>({ id:x.id, title:x.title, layer:x.layer, source:x.source || "" }));
  const summary = cleanText(items.map(x=>x.body || "").join("\n").replace(/\s+/g, " "), 260);
  const doctorName = doctor && doctor.name ? doctor.name : "医生";
  const body = [
    `【候选科普】${topic}`,
    `依据素材：${items.map(x=>cleanText(x.title, 40)).join(" / ")}`,
    summary ? `摘要：${summary}` : "",
    `群内引导：这是${doctorName}医生团队准备的科普候选稿，适合群友先做基础了解。涉及个人病情、报告结论、用药和手术决策时，请转医生/医助确认。`,
    "审核提示：发布前请医学运营或医助核对素材依据、时间有效性和群内表达；确认后再发送。"
  ].filter(Boolean).join("\n");
  return enqueue({
    doctorId:did,
    group,
    targetName:group.name,
    text:body,
    payload:{ eventType:"ops_content_candidate", topic, evidence, reviewerRequired:true, generatedAt:now(), source:"knowledge_items.ready" },
    status:"pending",
    source:"ops_candidate",
    priority:"normal",
    username:input && input.username
  });
}

/* ISO-8601 周键 'YYYY-Www'（手写零依赖）。用传入 Date 的 UTC 字段——调用方已把"北京墙钟"塞进 UTC 字段。
   ISO 规则：周一为周首；含某年首个周四的那一周为该 ISO 年的第 1 周。 */
function weekIso(date){
  const d = new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate()));
  const dayNum = (d.getUTCDay() + 6) % 7;             // 周一=0 … 周日=6
  d.setUTCDate(d.getUTCDate() - dayNum + 3);          // 移到本周周四（ISO 年由周四决定）
  const isoYear = d.getUTCFullYear();
  const jan4 = new Date(Date.UTC(isoYear, 0, 4));     // 1月4日必落在第 1 周
  const jan4DayNum = (jan4.getUTCDay() + 6) % 7;
  jan4.setUTCDate(jan4.getUTCDate() - jan4DayNum + 3); // 第 1 周的周四
  const week = 1 + Math.round((d.getTime() - jan4.getTime()) / (7 * 24 * 3600 * 1000));
  return `${isoYear}-W${String(week).padStart(2, "0")}`;
}

/* 周五定时群运营：被 server 的 setInterval（默认关，WEEKLY_OPS_AUTO=1 才起）按小时调用。
   逻辑：北京时间(UTC+8，无 DST) 周五 且 小时≥窗口阈值(默认 9) → 枚举「active 医生的 active 群」→
   该群所属医生已配 content.weeklyOps.defaultTopic（无则跳过，不产错科室草稿）→ 本 ISO 周尚未生成 →
   调 createWeeklyCampaign 入队 pending 草稿 → 记 weekly_auto_last_week=当前周键。
   绝不自动发（只产 pending，医助确认才发，沿用 setOutboxStatus）；幂等真相落 DB 列，对重启稳健；单进程假设。
   生产更稳的做法：关掉内置定时器、用外部 cron 每周五定点打现成 POST /api/admin/community/campaigns/weekly。 */
function runWeeklyAuto(now, opts){
  opts = opts || {};
  const hourThreshold = Number(opts.hour != null ? opts.hour : (process.env.WEEKLY_OPS_HOUR || 9));
  const ms = (now && typeof now.getTime === "function" ? now.getTime() : Date.now()) + 8 * 3600 * 1000;
  const bj = new Date(ms);                              // 北京墙钟塞进 UTC 字段
  const generated = [];
  if(bj.getUTCDay() !== 5) return generated;            // 非周五
  if(bj.getUTCHours() < hourThreshold) return generated;// 未到时段窗口
  const weekKey = weekIso(bj);
  const rows = db.prepare(`SELECT g.id AS gid, g.doctor_id AS did, g.weekly_auto_last_week AS lastWeek
    FROM community_groups g JOIN doctors d ON d.id=g.doctor_id
    WHERE g.status='active' AND d.active=1`).all();
  for(const r of rows){
    if(r.lastWeek === weekKey) continue;                 // 本周已生成 → 幂等跳过
    const { content } = doctorContent(r.did);
    const topic = content && content.weeklyOps && cleanText(content.weeklyOps.defaultTopic, 90);
    if(!topic) continue;                                 // 未配 defaultTopic → 跳过（不产错科室兜底草稿）
    try{
      const outbox = createWeeklyCampaign({ doctorId:r.did, groupId:r.gid });   // 仅入队 pending；绝不调 setOutboxStatus
      db.prepare("UPDATE community_groups SET weekly_auto_last_week=? WHERE id=?").run(weekKey, r.gid);
      generated.push({ groupId:r.gid, doctorId:r.did, outboxId:outbox.id, weekKey });
    }catch(e){
      // 单群失败不影响其它群；不抛（定时器内另有 try/catch 兜底）
      console.error("[weekly-auto] 群", r.gid, "生成失败:", e && e.message);
    }
  }
  return generated;
}

/* 防回环钩子（best-effort）：跳过"自己/医助/系统/应用"发出的消息，避免把我们发出的内容当成新入站再处理一遍。
   应用通道企微默认不回投自己的消息，风险低；会话存档通道（docs/06 §9.2 待办）必读到医助自己发的消息，
   届时由拉取侧标记 senderRole='self' 即可被此钩子拦下。 */
const SELF_SENDER_ROLES = new Set(["self", "assistant", "system", "app", "operator", "医助", "运营"]);
function isLoopbackInbound(input){
  if(!input) return false;
  if(input.fromSelf === true || input.isEcho === true) return true;
  const role = String(input.senderRole == null ? "" : input.senderRole).trim().toLowerCase();
  return SELF_SENDER_ROLES.has(role) || SELF_SENDER_ROLES.has(String(input.senderRole || "").trim());
}

function inboundLogBase(did, group, member, patientId, text){
  return {
    doctorId: did,
    patientId,
    patientName: member.display_name,
    senderId: member.external_user_id || String(member.id),
    channel: group.channel_type || "wechat",
    groupId: group.external_group_id || String(group.id),
    text
  };
}

/* 真实 QiWe 群消息归档。这里只负责事实落库；回复/卡片发送仍由 qiwe_bridge 的成熟链路处理。 */
function archiveQiweInbound(input){
  input = input || {};
  const did = Number(input.doctorId);
  const roomId = cleanText(input.roomId || input.externalGroupId, 120);
  if(!Number.isInteger(did) || did <= 0 || !roomId) return { accepted:false, reason:"invalid_event" };
  const hit = findQiweBusinessGroup(did, roomId);
  if(!hit.accepted) return { accepted:false, reason:hit.reason || "non_business_group" };
  const group = hit.group;
  const externalMsgId = cleanText(input.externalMsgId, 120);
  if(externalMsgId){
    const old = db.prepare("SELECT * FROM community_messages WHERE doctor_id=? AND external_msg_id=? LIMIT 1").get(did, externalMsgId);
    if(old) return { accepted:true, deduped:true, group:groupOut(group), message:messageOut(old), groupRow:group, messageId:old.id };
  }
  const member = upsertMember(did, group.id, {
    externalUserId:input.senderId,
    senderName:input.senderName,
    dataSource:"qiwe"
  });
  let patientId = null;
  try{
    patientId = resolvePatient({ doctorId:did, channel:"qiwe", externalId:member.external_user_id,
      groupId:group.id, displayName:member.display_name });
    if(patientId) db.prepare("UPDATE community_members SET patient_id=? WHERE id=?").run(patientId, member.id);
  }catch(e){}
  const msgType = cleanText(input.msgType || "text", 40);
  const body = cleanText(input.text, 1000);
  const r = db.prepare(`INSERT INTO community_messages(
    doctor_id,group_id,member_id,external_msg_id,sender_name,sender_role,msg_type,text,raw_payload,process_status,created_at,data_source
  ) VALUES(?,?,?,?,?,?,?,?,?,?,?,?)`).run(
    did,group.id,member.id,externalMsgId || null,member.display_name,"patient",msgType,body,
    JSON.stringify(input.rawPayload || {}),"received",now(),"qiwe"
  );
  const messageId = Number(r.lastInsertRowid);
  const logText = body || `[${msgType || "非文字"}消息]`;
  logInboundMessage({
    doctorId:did,
    patientId,
    patientName:member.display_name,
    senderId:member.external_user_id || String(member.id),
    channel:"qiwe",
    groupId:roomId,
    text:logText,
    sourceMessageId:messageId,
    isKeywordRule:!!(body && engine.match(did, body))
  });
  return { accepted:true, deduped:false, group:groupOut(group), member, patientId,
    message:messageOut(db.prepare("SELECT * FROM community_messages WHERE id=?").get(messageId)), groupRow:group, messageId };
}

async function handleInbound(input){
  const did = resolveDoctorId(input);
  if(!did) throw new Error("医生不存在或缺少 doctorId/doctorSlug");
  const group = findGroup(did, input);
  if(!group) throw new Error("群配置不存在");
  // E. 防回环：自己/医助/系统发出的消息直接忽略（不入库、不排队、不回复）
  if(isLoopbackInbound(input)){
    return { ok:true, skipped:"loopback", group:groupOut(group), message:null, outbox:null };
  }
  // D. 入站去重（幂等）：同医生同 external_msg_id 已存在 → 短路返回既有记录，不重复入库/排队/触发回复。
  //    （注意：db.js 的 external_msg_id 唯一索引留给 cc3 评估老库重复/空串后再加；本层先做应用级去重。）
  const dedupKey = cleanText(input.externalMsgId, 120);
  if(dedupKey){
    const dup = db.prepare("SELECT * FROM community_messages WHERE doctor_id=? AND external_msg_id=? ORDER BY id DESC LIMIT 1").get(did, dedupKey);
    if(dup){
      return { ok:true, deduped:true, group:groupOut(group), message:messageOut(dup), outbox:null };
    }
  }
  const eventType = cleanText(input.eventType || "message", 40);
  const dataSource = cleanText(input.dataSource, 20) || "manual";
  const member = upsertMember(did, group.id, { ...input, dataSource });
  // 把这条消息的发送人收敛到统一 patient_id（一人对应其所有群/单聊会话），best-effort 不阻断主流程
  let patientId = null;
  try{
    patientId = resolvePatient({ doctorId:did, channel:group.channel_type || "wechat", externalId:member.external_user_id,
      groupId:group.id, phone:member.phone, unionid:input.unionid, displayName:member.display_name });
    if(patientId && member.patient_id !== patientId) db.prepare("UPDATE community_members SET patient_id=? WHERE id=?").run(patientId, member.id);
  }catch(e){}
  const text = cleanText(input.text || input.content || "", 1000);
  const msgType = cleanText(input.msgType || (eventType === "member_join" ? "event" : "text"), 40);
  const mr = db.prepare(`INSERT INTO community_messages(
    doctor_id,group_id,member_id,external_msg_id,sender_name,sender_role,msg_type,text,raw_payload,process_status,created_at,data_source
  ) VALUES(?,?,?,?,?,?,?,?,?,?,?,?)`).run(
    did, group.id, member.id, cleanText(input.externalMsgId, 120), member.display_name, cleanText(input.senderRole || "patient", 40),
    msgType, text || (eventType === "member_join" ? `${member.display_name} 入群` : ""), JSON.stringify(input.rawPayload || input),
    "received", now(), dataSource
  );
  const messageId = mr.lastInsertRowid;

  // 群边界标记（Q2 + Phase A2a 等级）：仅对真实文本发言扫描；与医疗风险分级（scanRisk/triage）完全解耦——
  // 只写 moderation_flag/keys/level 给医助看，不触碰 risk_level / process_status / 自动发判定。
  // 在此处一次性写入，无论后续走 paused/welcome/empty/manual/rule/intent/triage 哪条分支都已落标。
  if(msgType === "text" && text){
    const mod = scanModeration(text);
    if(mod.flag){
      db.prepare("UPDATE community_messages SET moderation_flag=?,moderation_keys=?,moderation_level=? WHERE id=?")
        .run(mod.flag, mod.keys.join(","), mod.level, messageId);
    }
  }

  if(group.status === "paused" || group.review_mode === "paused"){
    db.prepare("UPDATE community_messages SET process_status=? WHERE id=?").run("paused", messageId);
    return { ok:true, group:groupOut(group), message:messageOut(db.prepare("SELECT * FROM community_messages WHERE id=?").get(messageId)), outbox:null };
  }

  if(eventType === "member_join"){
    const outboxes = [];
    const vars = scriptVars(did, group, member);
    const configuredWelcome = configuredScript(did, "groupWelcome", vars);
    const welcomeText = configuredWelcome || cleanText(group.welcome_text, 1200).replace(/\{patient\}/g, member.display_name);
    if(group.welcome_enabled && welcomeText){
      outboxes.push(enqueue({ doctorId:did, group, messageId, targetName:group.name,
        text:atName(member.display_name, welcomeText),
        payload:{ eventType, memberId:member.id }, source:"welcome", priority:"normal" }));
    }
    outboxes.push(enqueue({ doctorId:did, group, messageId, targetName:group.name,
      text:atName(member.display_name, joinFaqText(did, member.display_name)),
      payload:{ eventType, memberId:member.id, page:"faq", card:{ type:"mp", title:"群友常见问题", page:"faq" } },
      source:"faq_welcome", priority:"normal" }));
    db.prepare("UPDATE community_messages SET process_status=?,matched_source=? WHERE id=?").run("welcome_queued", "welcome,faq_welcome", messageId);
    return { ok:true, group:groupOut(group), message:messageOut(db.prepare("SELECT * FROM community_messages WHERE id=?").get(messageId)), outbox:outboxes[0] || null, outboxes };
  }

  if(!text){
    const vars = scriptVars(did, group, member);
    const key = msgType === "voice" || msgType === "audio" ? "voice" : "nonText";
    const script = configuredScript(did, key, vars) || configuredScript(did, "nonText", vars);
    if(group.auto_reply_enabled && script){
      const materialReview = triage.materialReviewSummary({ msgType, text, name:cleanText(input.fileName || input.filename || "", 120), mime:cleanText(input.mime || input.contentType || "", 80) });
      const out = enqueue({ doctorId:did, group, messageId, targetName:group.name, text:atName(member.display_name, script),
        payload:{ msgType, eventType, memberId:member.id, materialReview }, status:"pending", source:key === "voice" ? "voice_fallback" : "non_text_fallback", priority:"normal" });
      db.prepare("UPDATE community_messages SET process_status=?,matched_source=? WHERE id=?").run("non_text_pending_review", out.source, messageId);
      return { ok:true, group:groupOut(group), message:messageOut(db.prepare("SELECT * FROM community_messages WHERE id=?").get(messageId)), outbox:out };
    }
    db.prepare("UPDATE community_messages SET process_status=? WHERE id=?").run("ignored_empty", messageId);
    return { ok:true, group:groupOut(group), message:messageOut(db.prepare("SELECT * FROM community_messages WHERE id=?").get(messageId)), outbox:null };
  }

  if(!group.auto_reply_enabled){
    db.prepare("UPDATE community_messages SET process_status=? WHERE id=?").run("manual_only", messageId);
    logInboundMessage({ ...inboundLogBase(did, group, member, patientId, text), actionTaken:"manual_only", replyStatus:"pending" });
    return { ok:true, group:groupOut(group), message:messageOut(db.prepare("SELECT * FROM community_messages WHERE id=?").get(messageId)), outbox:null };
  }

  const gate = groupGate.shouldHandleGroupText({
    doctorId:did,
    text,
    rawText:text,
    senderName:member.display_name,
    evt:{ raw:input.rawPayload || input, msgData:input.msgData || {}, senderId:member.external_user_id, senderName:member.display_name, isGroup:true },
    cfg:null
  });
  if(!gate.ok){
    db.prepare("UPDATE community_messages SET risk_level=?,process_status=?,matched_source=? WHERE id=?")
      .run(gate.riskLevel || "low", "group_chitchat", "group_gate", messageId);
    logInboundMessage({ ...inboundLogBase(did, group, member, patientId, text), isSilent:true });
    return { ok:true, skipped:gate.skipped || gate.reason || "group_chitchat", gate,
      group:groupOut(group), message:messageOut(db.prepare("SELECT * FROM community_messages WHERE id=?").get(messageId)), outbox:null };
  }

  const matched = engine.match(did, text);
  if(matched){
    const vars = scriptVars(did, group, member);
    const baseReply = matched.menu ? buildMenuText(doctorContent(did).content) : responseToText(matched.responses, member.display_name);
    const reply = matched.menu ? baseReply : mergeConfiguredReply(configuredCodeScript(did, matched.code, vars), baseReply);
    const status = group.review_mode === "auto_keywords" ? "sent" : "pending";
    const out = enqueue({ doctorId:did, group, messageId, targetName:group.name, text:reply, payload:{ matched }, status, source:"keyword_rule", priority:"normal" });
    db.prepare("UPDATE community_messages SET risk_level=?,process_status=?,matched_source=? WHERE id=?").run("low", status === "sent" ? "rule_auto_sent" : "rule_pending_review", "keyword_rule", messageId);
    logInboundMessage({ ...inboundLogBase(did, group, member, patientId, text), isKeywordRule:true, autoSent: status === "sent" });
    return { ok:true, group:groupOut(group), message:messageOut(db.prepare("SELECT * FROM community_messages WHERE id=?").get(messageId)), outbox:out };
  }

  // 关键词/编号未精确命中时，先做「意图识别」：自由文本→医生已配置的编号（"想咨询"→101、"怎么挂号"→303）。
  // 命中编号 = 医生预置安全话术，与关键词同等对待（auto_keywords 群可自动发，否则草稿待审）。
  // 病情/诊断/用药/手术等 classifyIntent 会判 medical→不命中编号，继续走下面的 AI 分诊转人工。
  const intent = await triage.classifyIntent(did, text);
  // 记账修正（2026-07-09）：971b3be medium 窄口（source='model_service_intent'）的消息本地原始风险=medium（仅手术决策类触发词），
  // 审计 risk_level 保留 medium 不写 low——只改记账值；自动发行为（status/matched_source/outbox 话术）一字不动，窄口仍只发确定性编号话术。
  const intentAuditRisk = intent && intent.source === "model_service_intent" ? "medium" : "low";
  if(intent && intent.menu){
    const reply = buildMenuText(doctorContent(did).content);
    const status = group.review_mode === "auto_keywords" ? "sent" : "pending";
    const out = enqueue({ doctorId:did, group, messageId, targetName:group.name, text:reply,
      payload:{ matched:{ menu:true }, intentSource:intent.source }, status, source:"ai_intent", priority:"normal" });
    db.prepare("UPDATE community_messages SET risk_level=?,process_status=?,matched_source=? WHERE id=?")
      .run(intentAuditRisk, status === "sent" ? "intent_auto_sent" : "intent_pending_review", "ai_intent:menu", messageId);
    logInboundMessage({ ...inboundLogBase(did, group, member, patientId, text), isKeywordRule:true, autoSent: status === "sent" });
    return { ok:true, group:groupOut(group), message:messageOut(db.prepare("SELECT * FROM community_messages WHERE id=?").get(messageId)), outbox:out };
  }
  if(intent && intent.code && Array.isArray(intent.responses)){
    // 103 意图候选增强（2026-07-10）：闸从「responses 非空」放宽为「产出内容非空」——
    // mergeConfiguredReply(code脚本, responses文本) 非空即发（103 responses=[] 但有电话话术→发出）；
    // 无 responses 且无脚本→合并为空→fallthrough 到 handleIncoming（行为不变）。
    const vars = scriptVars(did, group, member);
    const merged = mergeConfiguredReply(configuredCodeScript(did, intent.code, vars), responseToText(intent.responses, member.display_name));
    if(merged){
      const reply = atName(member.display_name, merged);
      const status = group.review_mode === "auto_keywords" ? "sent" : "pending";
      const out = enqueue({ doctorId:did, group, messageId, targetName:group.name, text:reply,
        payload:{ matched:{ code:intent.code, responses:intent.responses }, intentSource:intent.source }, status, source:"ai_intent", priority:"normal" });
      db.prepare("UPDATE community_messages SET risk_level=?,process_status=?,matched_source=? WHERE id=?")
        .run(intentAuditRisk, status === "sent" ? "intent_auto_sent" : "intent_pending_review", "ai_intent:" + intent.code, messageId);
      logInboundMessage({ ...inboundLogBase(did, group, member, patientId, text), isKeywordRule:true, autoSent: status === "sent" });
      return { ok:true, group:groupOut(group), message:messageOut(db.prepare("SELECT * FROM community_messages WHERE id=?").get(messageId)), outbox:out };
    }
  }

  const tri = await triage.handleIncoming({
    doctorId:did,
    text,
    patientName:member.display_name,
    patientKey:`community:${group.id}:${member.external_user_id || member.id}`,
    patientId,
    isGroup:true   // 社群入站=群场景（甲方 2026-07-03 群内脱敏裁定：低危 LLM 生成输入结构上拿不到档案，只传称呼）
  });
  // 三档（甲方 2026-07-02 裁定）：AI 分诊在「auto_keywords 群」按 triage.canAutoSend 放行 low/high 自动发（medium 恒 pending）；
  // 其余 review_mode（human_review 等）维持全 pending——AI 分诊绝不比确定性关键词更宽松（auto_reply_enabled=0 已在上方整体 manual_only）。
  // 自动发文本 tri.response.text=患者侧 patientReply（low 档 LOW_RISK_LLM_REPLY=1 时为过双闸的 LLM 文本、否则确定性安全模板；high 另附 101 入口卡的文本链接行），绝不自动发模型草稿 tri.draft（=medium 的 aiDraft）；
  // pending 草稿仍优先带模型建议(tri.draft)给医助审核（高危无草稿=安全话术+卡片行）。
  const status = (group.review_mode === "auto_keywords" && tri.triage && tri.triage.canAutoSend === true) ? "sent" : "pending";
  const priority = tri.triage && tri.triage.riskLevel === "high" ? "urgent" : tri.triage && tri.triage.needsHuman ? "high" : "normal";
  const entryLines = triageEntryCardLines(tri);
  const baseText = status === "sent"
    ? ((tri.response && tri.response.text) || "")
    : ((tri.draft || (tri.response && tri.response.text)) || "");
  const vars = scriptVars(did, group, member);
  const humanScript = tri.triage && tri.triage.needsHuman && status !== "sent" ? configuredScript(did, "transferHuman", vars) : "";
  // 高危自动发送仍只走 triage 的固定安全模板；运营 emergency 文案仅作为待审草稿提示，避免配置削弱红线话术。
  const emergencyScript = tri.triage && tri.triage.riskLevel === "high" && status !== "sent" ? configuredScript(did, "emergency", vars) : "";
  const outText = [humanScript, emergencyScript, baseText, entryLines].filter(Boolean).join("\n");
  const out = enqueue({ doctorId:did, group, messageId, targetName:group.name, text:outText,
    payload:{ triage:tri.triage, triageSessionId:tri.sessionId, triageDecisionId:tri.decisionId, entryCode:(tri.entryCode || "") },
    status, source:"ai_triage", priority });
  db.prepare(`UPDATE community_messages SET risk_level=?,process_status=?,matched_source=?,triage_session_id=?,decision_id=? WHERE id=?`)
    .run((tri.triage && tri.triage.riskLevel) || "low", status === "sent" ? "triage_auto_sent" : "triage_pending_review", "ai_triage", tri.sessionId, tri.decisionId, messageId);

  logInboundMessage({
    ...inboundLogBase(did, group, member, patientId, text),
    aiDraft: tri.draft || null,
    triageSessionId: tri.sessionId || null,
    autoSent: status === "sent"
  });

  return { ok:true, group:groupOut(group), message:messageOut(db.prepare("SELECT * FROM community_messages WHERE id=?").get(messageId)), outbox:out, triage:tri.triage };
}

/* 解析这条出站消息「单聊回个人」的 touser（企微成员/外部 userid）。
   链路：outbound_queue.message_id → community_messages.member_id → community_members.external_user_id。
   仅在能稳定解出真实 external_user_id（非 local- 本地占位）时返回，否则返回 ""（→ 闸控真发回落"仅标 sent"）。
   注：群发/外部联系人发的 touser 口径（chatid vs userid、成员 vs 外部联系人）属 Part 2，本轮只覆盖单聊 best-effort。 */
function resolveOutboxTouser(row){
  if(!row || !row.message_id) return "";
  const m = db.prepare(`SELECT cm.external_user_id AS uid
    FROM community_messages msg JOIN community_members cm ON cm.id=msg.member_id
    WHERE msg.id=?`).get(+row.message_id);
  const uid = m && m.uid ? String(m.uid).trim() : "";
  if(!uid || uid.startsWith("local-")) return "";   // 本地占位/无外部身份 → 不真发，回落标 sent
  return uid;
}
/* 是否配齐"自建应用真发"凭证（与 wecom.sendAppText/getAccessToken 的最小必需对齐）。 */
function canRealSend(cfg){ return !!(cfg && cfg.corpId && cfg.secret && cfg.agentId); }

/* 闸控真发：医助点"确认发送"才走到这里（始终人工确认，AI 绝不自动发——不变量3）。
   - 取消/置回 pending：仅改状态（原逻辑）。
   - 确认发送(sent)：
     · 已是 sent → 幂等直接返回（不重发，防重复发送）。
     · 配齐应用凭证 且 能解出单聊 touser 且 未超重试上限 → 真调 wecom.sendAppText：
         成功 → status=sent + external_msg_id=msgid + sent_at/sent_by；
         失败 → 不翻 sent，status 维持 pending + 记 send_error + attempts++；attempts≥上限 → 拒发并抛错。
     · 凭证不齐 / 解不出 touser / 群发 → 回落现状（仅标 sent = 医助已手动发，V1 默认安全兜底）。 */
function realSendUnavailable(row){
  const ch = row && row.channel_type || "";
  if(ch === "qiwe") return "缺少 QiWe token/guid 或 toId，未执行真实发送";
  if(ch === "wecom") return "缺少企微应用凭证或 touser，未执行真实发送";
  return "该出站渠道没有真实发送实现，未执行真实发送";
}

async function setOutboxStatus(id, status, username, options){
  const opts = options || {};
  // 'ignored'（忽略=关闭不发，与 cancelled 同走非 sent 分支，仅改 status + 清 sent_at/by，绝不发送）。
  const allowed = new Set(["sent", "cancelled", "pending", "ignored"]);
  const next = allowed.has(status) ? status : "sent";
  const row = db.prepare("SELECT * FROM outbound_queue WHERE id=?").get(+id);
  if(!row) throw new Error("出站消息不存在");

  if(next !== "sent"){
    // 转任何非 sent 态(pending/cancelled/ignored)都要求当前=pending：已 sent/已关闭的记录绝不改，
    // 防清掉发送审计 sent_at/sent_by（堵 /ignore、H1 /cancel，及 #5a 的 sent→pending 置回清审计+重发）。
    if(row.status !== "pending"){
      throw new Error(next === "pending" ? "已发送/已关闭的记录不可置回待发送" : "仅待发送草稿可忽略/取消");
    }
    db.prepare("UPDATE outbound_queue SET status=?,sent_at=?,sent_by=?,updated_by=?,updated_at=? WHERE id=?").run(next, null, null, username || "admin", now(), +id);
    return outboxOut(db.prepare("SELECT * FROM outbound_queue WHERE id=?").get(+id));
  }

  // 幂等：已发送过的不重发
  if(row.status === "sent") return outboxOut(row);

  // 原子抢占（并发去重·不变量③）：任何真实投递前把 pending→sending。node:sqlite 同步执行，此 UPDATE 在任何 await
  //   之前完成即为原子闸——两个并发请求（AI 分诊台 confirm / 社群工作台 send 都汇入本函数）只有一个能把 pending 抢成
  //   sending（changes===1）真正投递，另一个 changes===0 → 直接抛错、绝不进入 await 投递（否则患者收到重复消息）。
  //   'sending' 是内部瞬时态：① 不在外部 API allowed 集合（外部不可设）；② findOutboxRowForDecision 的
  //   IN('pending','sent') 不含它（在途单不被再绑发送）；③ 非 sent 分支（cancel/ignore/置回 pending）要求 row.status==='pending'
  //   → sending 行一律拒改，绝不清审计。进程崩溃可能遗留 sending 孤行（罕见运维场景，不做自动超时回收，保持简单）——
  //   人工把该行 status 改回 'pending' 即可重试。
  const preemptSending = ()=>{
    const r = db.prepare("UPDATE outbound_queue SET status='sending',updated_by=?,updated_at=? WHERE id=? AND status='pending'")
      .run(username || "admin", now(), +id);
    if(r.changes !== 1) throw new Error("该草稿正在发送中或已发送，请勿重复操作");
  };

  const cfg = wecom.loadConfig();
  const touser = resolveOutboxTouser(row);
  const isWecom = (row.channel_type || "") === "wecom";
  // 满足真发条件：企微渠道 + 配齐应用凭证 + 能解出单聊 touser
  if(isWecom && canRealSend(cfg) && touser){
    if((row.attempts || 0) >= SEND_MAX_ATTEMPTS) throw new Error("发送失败次数已达上限，请人工核查后处理");
    preemptSending();   // await 前原子抢占：抢不到（并发/在途）直接抛「正在发送中」，不进入真实发送
    try{
      const r = await wecom.sendAppText(cfg, touser, row.text || "");
      // sent_mode='real'：经企微官方通道真实投递成功 → 分诊台 alreadySent 可据此放行（溯源标记跟代码路径不跟环境）。
      db.prepare("UPDATE outbound_queue SET status='sent',sent_mode='real',sent_at=?,sent_by=?,external_msg_id=?,send_error=NULL,updated_by=?,updated_at=? WHERE id=?")
        .run(now(), username || "admin", (r && r.msgid) ? String(r.msgid) : null, username || "admin", now(), +id);
      return outboxOut(db.prepare("SELECT * FROM outbound_queue WHERE id=?").get(+id));
    }catch(e){
      // 真发失败：把本次抢占的 sending 回滚 pending（WHERE status='sending' 只碰自己抢的行），记错误 + 累加尝试次数（attempts≥上限后下次直接拒发）
      db.prepare("UPDATE outbound_queue SET status='pending',send_error=?,attempts=COALESCE(attempts,0)+1,updated_by=?,updated_at=? WHERE id=? AND status='sending'")
        .run(String((e && e.message) || "发送失败").slice(0, 500), username || "admin", now(), +id);
      throw new Error("企微发送失败：" + ((e && e.message) || ""));
    }
  }

  // qiwe 渠道（第三方 qiweapi）真发：守门 = token&&guid（仿 wecom canRealSend，不查 enabled——医助手动确认在 autoSend 关时也该能发）+ 解出 toId。
  // 闸控/重试/幂等/兜底与上面 wecom 分支同构；卡片由 qiweBridge.deliverOutbox 按 code 重查模板必发，未就绪发文本链接（链接不丢）。
  if((row.channel_type || "") === "qiwe"){
    const qcfg = qiwe.loadConfig();
    let qpayload = {};
    try{ qpayload = row.payload ? JSON.parse(row.payload) : {}; }catch(e){ qpayload = {}; }
    const qtoId = qpayload && qpayload.qiwe ? String(qpayload.qiwe.toId || "").trim() : "";
    if(qcfg.token && qcfg.guid && qtoId){
      if((row.attempts || 0) >= SEND_MAX_ATTEMPTS) throw new Error("发送失败次数已达上限，请人工核查后处理");
      preemptSending();   // await 前原子抢占：抢不到（并发/在途）直接抛「正在发送中」，不进入真实发送
      try{
        const r = await qiweBridge.deliverOutbox(row, qcfg);
        // fail-closed（codex 反例B·2026-07-03）：反例3 修复后 deliverOutbox 遇 weapp 失败+无 fallback+有卡不再 throw；
        //   若 sendLink 也全失败 → 返回 sent:false（未发出任何部分）。此处必须检查 r.sent，否则会把未发出的行误标 sent（消息丢失、医助以为已发）。
        //   全失败 → throw → 落下方同层 catch：行保持 pending + send_error + attempts+1，与旧「无可发回落即 throw」语义等价。
        if(!r || !r.sent) throw new Error("QiWe 投递未发出任何部分（weapp/文本/卡片全部失败），草稿保持待发送");
        // sent_mode='real'：经 qiweapi 第三方通道真实投递成功 → 分诊台 alreadySent 可据此放行（溯源标记跟代码路径不跟环境，DRY_RUN 桩走同路径同标 real）。
        db.prepare("UPDATE outbound_queue SET status='sent',sent_mode='real',sent_at=?,sent_by=?,external_msg_id=?,send_error=NULL,updated_by=?,updated_at=? WHERE id=?")
          .run(now(), username || "admin", (r && r.externalMsgId) ? String(r.externalMsgId) : null, username || "admin", now(), +id);
        return outboxOut(db.prepare("SELECT * FROM outbound_queue WHERE id=?").get(+id));
      }catch(e){
        // 真发失败：把本次抢占的 sending 回滚 pending（WHERE status='sending' 只碰自己抢的行）+ 记错误 + attempts++，保持可重试
        db.prepare("UPDATE outbound_queue SET status='pending',send_error=?,attempts=COALESCE(attempts,0)+1,updated_by=?,updated_at=? WHERE id=? AND status='sending'")
          .run(String((e && e.message) || "发送失败").slice(0, 500), username || "admin", now(), +id);
        throw new Error("企微发送失败：" + ((e && e.message) || ""));
      }
    }
    // 凭证不齐 / 解不出 toId → 常规社群审核台落 V1 兜底（仅标 sent）。
    // AI 分诊台调用 requireRealSend 时必须失败，避免把无外部目标的草稿假标已发送。
  }

  if(opts.requireRealSend) throw new Error(realSendUnavailable(row));

  // V1 兜底：未配凭证 / 非企微 / 解不出单聊 touser（含群发）→ 仅标 sent（= 医助已手动发，默认安全）
  // sent_mode='manual'：社群工作台声明「已手动发」，未经真实通道投递 → 分诊台 alreadySent 不认（sendOutboxForDecision fail-closed 拒确认）。社群工作台行为不变。
  db.prepare("UPDATE outbound_queue SET status='sent',sent_mode='manual',sent_at=?,sent_by=?,updated_by=?,updated_at=? WHERE id=?").run(now(), username || "admin", username || "admin", now(), +id);
  return outboxOut(db.prepare("SELECT * FROM outbound_queue WHERE id=?").get(+id));
}

async function sendOutboxForDecision(decisionId, text, username){
  const did = Number(decisionId);
  const d = Number.isInteger(did) && did > 0
    ? db.prepare(`SELECT x.*, s.doctor_id AS doctor_id, s.status AS session_status
      FROM triage_decisions x JOIN triage_sessions s ON s.id=x.session_id
      WHERE x.id=?`).get(did)
    : null;
  if(!d) throw new Error("分诊决策不存在");
  if(d.status === "confirmed_sent") throw new Error("该回复已发送，请勿重复发送");
  if(d.session_status === "closed") throw new Error("会话已标记处理，无法再发送");

  const finalText = cleanText(text || d.final_text || "", 2400);
  if(!finalText) throw new Error("发送内容不能为空");

  const row = findOutboxRowForDecision(did);
  if(!row){
    // 并发去重：另一请求可能已把该行抢成在途 'sending'（findOutboxRowForDecision 不含 sending）→ 报「正在发送中」比「没有队列」更准
    if(findSendingRowForDecision(did)) throw new Error("该回复正在发送中，请勿重复操作");
    throw new Error("没有找到这条分诊对应的真实出站队列，不能在 AI 分诊台确认发送；请到社群工作台处理，或重新从真实企微消息进入");
  }
  if(row.status === "sent"){
    // 发送方式溯源 fail-closed（codex 反例3 修）：仅当该行经真实企微通道投递成功（sent_mode='real'）才据此放行 alreadySent。
    // sent_mode='manual'（社群工作台 V1 兜底声明手动发·未经真实通道）或 NULL（旧生产行/本地通道 enqueue/auto_keywords 等非企微真发）
    // 一律拒绝：否则「先在社群工作台标 sent → 分诊台见 sent 直接放行 → confirmDecision 落 confirmed_sent」= 未经真实通道也能确认（本批「不假标」目标被绕过）。
    // 旧生产行全 NULL（迁移前无此列）→ 分诊台一律拒确认、改走社群工作台，符合本批 fail-closed 口径。
    if(row.sent_mode === "real"){
      return { ok:true, alreadySent:true, outbox:outboxOut(row) };
    }
    throw new Error("该队列是人工标记的已发送、未经真实通道投递，分诊台不能据此确认；如确已人工发出请在社群工作台保持记录并用『标记已处理』关闭分诊会话");
  }
  const edited = editOutboxText(row.id, finalText, username);
  const sent = await setOutboxStatus(row.id, "sent", username, { requireRealSend:true });
  return { ok:true, alreadySent:false, edited, outbox:sent };
}

/* 审核台「改字」：仅 pending 草稿可改正文，只动 text（不碰 payload/卡片/其它列）；改完仍需医助点「确认发送」才发。 */
function editOutboxText(id, text, username){
  const row = db.prepare("SELECT * FROM outbound_queue WHERE id=?").get(+id);
  if(!row) throw new Error("出站消息不存在");
  if(row.status !== "pending") throw new Error("仅待发送草稿可编辑");
  const next = cleanText(text, 2400);
  if(!next) throw new Error("内容不能为空");
  db.prepare("UPDATE outbound_queue SET text=?,updated_by=?,updated_at=? WHERE id=? AND status='pending'").run(next, username || "admin", now(), +id);
  return outboxOut(db.prepare("SELECT * FROM outbound_queue WHERE id=?").get(+id));
}

/* 审核台「转医生 / 撤回」：仅 pending 草稿可标记；assignee='doctor'（需医生定夺）或 null（撤回给医助默认）。
   只动 assignee，status 仍 pending、留队列、绝不触发发送（仅可见标记）。 */
function setOutboxAssignee(id, assignee, username){
  const row = db.prepare("SELECT * FROM outbound_queue WHERE id=?").get(+id);
  if(!row) throw new Error("出站消息不存在");
  if(row.status !== "pending") throw new Error("仅待发送草稿可转医生/撤回");
  const next = assignee === "doctor" ? "doctor" : null;
  db.prepare("UPDATE outbound_queue SET assignee=?,updated_by=?,updated_at=? WHERE id=? AND status='pending'").run(next, username || "admin", now(), +id);
  return outboxOut(db.prepare("SELECT * FROM outbound_queue WHERE id=?").get(+id));
}

/* 主动提醒（站内只读）：聚合 status='待跟进' 且 type∈REMINDER_TYPES 的提交 → 计数 + 最近列表（summary 由调用方 maskPII 脱敏）。
   纯只读 SELECT，绝不触发任何发送/outbound；已读=沿用现有 待跟进→已联系 状态切换（无新列）。 */
function reminderSummary(payload){
  const p = payload || {};
  const parts = [p["姓名"], p["手机号"], p["主要疾病"] || p["疾病"], p["期望就诊日"] || p["期望住院日"] || p["期望日期"]]
    .map(x=>String(x == null ? "" : x).trim()).filter(Boolean);
  return parts.join(" · ").slice(0, 200);
}
function reminders(doctorId){
  const did = +doctorId;
  const counts = {};
  let total = 0;
  for(const t of REMINDER_TYPES){
    const c = db.prepare("SELECT COUNT(*) c FROM submissions WHERE doctor_id=? AND type=? AND status='待跟进'").get(did, t).c;
    counts[t] = c; total += c;
  }
  const placeholders = REMINDER_TYPES.map(()=>"?").join(",");
  const rows = db.prepare(`SELECT id,type,payload,created_at FROM submissions
    WHERE doctor_id=? AND status='待跟进' AND type IN (${placeholders}) ORDER BY id DESC LIMIT 30`).all(did, ...REMINDER_TYPES);
  const items = rows.map(r=>({ id:r.id, type:r.type, createdAt:r.created_at, summary:reminderSummary(j(r.payload, {})) }));
  return { ok:true, total, counts, items };
}

