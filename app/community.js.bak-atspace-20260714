/* 群名命名模板：按 content.groupNaming.pattern（缺失用默认）填占位 {医生}/{科室}/{序号}。
   纯函数、不触库；seq 传空串则 {序号} 省略（用于生成企微 room_base_name 前缀）。 */
function buildGroupName(doctor, content, seq){
  const pattern = cleanText(content && content.groupNaming && content.groupNaming.pattern, 120) || DEFAULT_GROUP_NAME_PATTERN;
  const dname = String((doctor && doctor.name) || "").trim();
  const dept = String((doctor && doctor.dept) || "").trim();
  const n = Number(seq);
  const seqStr = (seq === "" || seq == null) ? "" : (Number.isFinite(n) && n > 0 ? String(n) : "");
  return cleanText(pattern
    .replace(/\{医生\}/g, dname)
    .replace(/\{科室\}/g, dept)
    .replace(/\{序号\}/g, seqStr), 120);
}

/* 建群建议名 + 企微自动建群 room_base_name 建议（供后台展示/抄配，不真建群）。 */
function suggestGroupName(doctorId){
  const did = +doctorId;
  if(!db.prepare("SELECT 1 FROM doctors WHERE id=?").get(did)) throw new Error("医生不存在");
  const { content, doctor } = doctorContent(did);
  const pattern = cleanText(content.groupNaming && content.groupNaming.pattern, 120) || DEFAULT_GROUP_NAME_PATTERN;
  const seq = db.prepare("SELECT COUNT(*) c FROM community_groups WHERE doctor_id=?").get(did).c + 1;
  return {
    suggestedName: buildGroupName(doctor, content, seq),
    pattern,
    roomBaseName: buildGroupName(doctor, content, "")   // 去掉 {序号} 的前缀，企微自动建群会自行追加序号
  };
}

function createGroup(input){
  const did = +input.doctorId;
  if(!db.prepare("SELECT 1 FROM doctors WHERE id=?").get(did)) throw new Error("医生不存在");
  const channel = CHANNEL_TYPES.has(input.channelType) ? input.channelType : "wechat";
  const reviewMode = REVIEW_MODES.has(input.reviewMode) ? input.reviewMode : "human_review";
  const status = GROUP_STATUS.has(input.status) ? input.status : "pilot";
  let name = cleanText(input.name, 120);
  if(!name){
    // name 为空 → 按命名模板 + 序号(该医生现有群数+1) 自动生成；医助手动填名则原样放行，不强制校验。
    const { content, doctor } = doctorContent(did);
    const seq = db.prepare("SELECT COUNT(*) c FROM community_groups WHERE doctor_id=?").get(did).c + 1;
    name = cleanText(buildGroupName(doctor, content, seq), 120);
  }
  if(!name) throw new Error("群名称必填");
  const r = db.prepare(`INSERT INTO community_groups(
    doctor_id,channel_type,external_group_id,name,owner,member_count,status,welcome_enabled,welcome_text,
    auto_reply_enabled,review_mode,qrcode_url,notes,created_at,updated_at
  ) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)`).run(
    did, channel, cleanText(input.externalGroupId, 120) || null, name, cleanText(input.owner, 80),
    cleanInt(input.memberCount), status, input.welcomeEnabled === false ? 0 : 1, cleanText(input.welcomeText, 1200),
    input.autoReplyEnabled === false ? 0 : 1, reviewMode, cleanText(input.qrcodeUrl, 500), cleanText(input.notes, 1200),
    now(), now()
  );
  db.prepare("UPDATE community_groups SET data_source='manual',is_business=0 WHERE id=?").run(r.lastInsertRowid);
  return groupOut(db.prepare("SELECT * FROM community_groups WHERE id=?").get(r.lastInsertRowid));
}

function updateGroup(id, input){
  const g = db.prepare("SELECT * FROM community_groups WHERE id=?").get(+id);
  if(!g) throw new Error("群配置不存在");
  input = input || {};
  const channel = CHANNEL_TYPES.has(input.channelType) ? input.channelType : g.channel_type;
  const reviewMode = REVIEW_MODES.has(input.reviewMode) ? input.reviewMode : g.review_mode;
  const status = GROUP_STATUS.has(input.status) ? input.status : g.status;
  const name = cleanText(input.name || g.name, 120);
  if(!name) throw new Error("群名称必填");
  db.prepare(`UPDATE community_groups SET channel_type=?,external_group_id=?,name=?,owner=?,member_count=?,status=?,
    welcome_enabled=?,welcome_text=?,auto_reply_enabled=?,review_mode=?,qrcode_url=?,notes=?,updated_at=? WHERE id=?`).run(
    channel,
    Object.prototype.hasOwnProperty.call(input, "externalGroupId") ? (cleanText(input.externalGroupId, 120) || null) : g.external_group_id,
    name,
    Object.prototype.hasOwnProperty.call(input, "owner") ? cleanText(input.owner, 80) : g.owner,
    Object.prototype.hasOwnProperty.call(input, "memberCount") ? cleanInt(input.memberCount) : g.member_count,
    status,
    Object.prototype.hasOwnProperty.call(input, "welcomeEnabled") ? (input.welcomeEnabled ? 1 : 0) : g.welcome_enabled,
    Object.prototype.hasOwnProperty.call(input, "welcomeText") ? cleanText(input.welcomeText, 1200) : g.welcome_text,
    Object.prototype.hasOwnProperty.call(input, "autoReplyEnabled") ? (input.autoReplyEnabled ? 1 : 0) : g.auto_reply_enabled,
    reviewMode,
    Object.prototype.hasOwnProperty.call(input, "qrcodeUrl") ? cleanText(input.qrcodeUrl, 500) : g.qrcode_url,
    Object.prototype.hasOwnProperty.call(input, "notes") ? cleanText(input.notes, 1200) : g.notes,
    now(), +id
  );
  if(Object.prototype.hasOwnProperty.call(input, "isBusiness")){
    const current = db.prepare("SELECT data_source,external_group_id FROM community_groups WHERE id=?").get(+id);
    const hasRealId = !!(current && !isPlaceholderGroupId(current.external_group_id));
    if(input.isBusiness && !(hasRealId || (current && current.data_source === "qiwe"))){
      throw new Error("只有已绑定真实企微群 ID 的群可设为业务群");
    }
    // 种子/历史 wecom 映射群：勾选业务群时同步标为 qiwe，便于门禁与 KPI 口径一致
    if(input.isBusiness && hasRealId && current.data_source !== "qiwe"){
      db.prepare("UPDATE community_groups SET data_source='qiwe' WHERE id=?").run(+id);
    }
    db.prepare("UPDATE community_groups SET is_business=? WHERE id=?").run(input.isBusiness ? 1 : 0, +id);
  }
  return groupOut(db.prepare("SELECT * FROM community_groups WHERE id=?").get(+id));
}

function findGroup(doctorId, input){
