      qiwe:qiweSafe,
      context:{
        groupId,
        externalUserId:userId,
        group:currentGroup ? {
          id:currentGroup.id,
          name:currentGroup.name || "",
          externalGroupId:currentGroup.external_group_id || "",
          memberCount:currentGroup.member_count || 0,
          status:currentGroup.status || ""
        } : null,
