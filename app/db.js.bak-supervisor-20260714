// 业务群兼容迁移：种子/历史「真实企微群」映射原先 data_source=manual 且 is_business=0，
 // Codex 业务群门禁上线后会导致群消息全静默（无回复、分诊台空白）。把已绑定真实 roomId 的企微群提升为可接收业务数据。
try{
  db.prepare(`UPDATE community_groups
    SET data_source='qiwe', is_business=1, updated_at=COALESCE(updated_at, datetime('now'))
    WHERE is_business=0
      AND external_group_id IS NOT NULL AND TRIM(external_group_id) != ''
      AND external_group_id NOT LIKE 'local-%'
      AND external_group_id NOT LIKE 'test-%'
      AND external_group_id NOT LIKE 'ft-%'
      AND (
        channel_type IN ('wecom','qiwe')
        OR notes LIKE '%真实企微%'
        OR notes LIKE '%真实群%'
        OR LENGTH(TRIM(external_group_id)) >= 10
      )`).run();
}catch(e){ console.error("[db] business group migrate:", e && e.message); }
