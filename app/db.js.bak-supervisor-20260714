/* 轻量迁移：给已存在的 data.db 补列（PRAGMA 守卫，幂等） */
function ensureColumn(table, col, type){
  const cols = db.prepare(`PRAGMA table_info(${table})`).all();
  if(!cols.some(c=>c.name===col)) db.exec(`ALTER TABLE ${table} ADD COLUMN ${col} ${type}`);
}
