.intake-src{margin-top:8px;font-size:11.5px;color:#aaa}
.judge-reason{font-size:13px;color:#444;line-height:1.75;background:#fff9ed;border-left:3px solid #ffb020;padding:9px 10px;margin-top:12px;border-radius:0 8px 8px 0}
.judge-basis{font-size:12px;color:#888;line-height:1.65;margin-top:8px}
.mini-kv{max-height:78px;overflow:auto;margin-top:10px;background:#fbfbfc;border-radius:8px;padding:8px;font-size:12px;line-height:1.8;color:#666}
.hist{display:flex;gap:10px;border-bottom:1px solid #f0f0f0;padding:8px 0;align-items:flex-start}
.hist:last-child{border-bottom:none}
.hist b{font-size:12px;color:#07a050;min-width:66px}
.hist span{font-size:12px;color:#666;line-height:1.55}
.triage-empty p{color:#777;line-height:1.8}
/* 候补名单 */
.wl-slot{border:1px solid #edf0f2;border-radius:10px;padding:12px 14px;margin-bottom:12px;background:#fbfcfd}
.wl-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;gap:10px;flex-wrap:wrap}
.wl-head b{font-size:15px}
.wl-cnt{font-size:12.5px;color:#888;margin-left:6px}
/* 随访队列 */
.card h2 .btn{font-weight:600}
.fq-wrap{display:grid;grid-template-columns:minmax(240px,.8fr) minmax(360px,1.2fr);gap:14px;align-items:start}
.fq-list{display:flex;flex-direction:column;gap:8px;max-height:560px;overflow:auto}
.fq-item{border:1px solid #e5e9ed;background:#fff;border-radius:10px;padding:10px 12px;text-align:left;cursor:pointer}
.fq-item.on{border-color:#07c160;background:#effbf4;box-shadow:0 0 0 2px rgba(7,193,96,.08)}
.fq-item .fq-top{display:flex;justify-content:space-between;align-items:center}
.fq-item .fq-top b{font-size:14px}
.fq-item .fq-tail{font-size:11.5px;color:#999}
.fq-item .fq-plan{font-size:12.5px;color:#555;margin:3px 0}
