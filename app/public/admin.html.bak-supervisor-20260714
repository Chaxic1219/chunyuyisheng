.intake-row b{font-size:13px;color:#222;line-height:1.45;font-weight:600;word-break:break-word}
.intake-flags{margin-top:10px;font-size:12.5px;color:#e03131;background:#fff0f0;border-radius:8px;padding:7px 10px;line-height:1.6}
