<script>
// 分诊台手动回复功能 [2026-07-13]
setInterval(function(){
  if(document.getElementById("triageManualReplyBox")) return;
  // 找到"标记已处理"按钮
  var btns = document.querySelectorAll("button");
  var target = null;
  btns.forEach(function(b){ if(b.textContent.trim()==="标记已处理") target = b; });
  if(!target) return;
  var container = target.parentElement;
  if(!container) return;
  var div = document.createElement("div");
  div.id = "triageManualReplyBox";
  div.style.cssText = "margin-top:14px;padding-top:14px;border-top:1px solid #e8e8e8";
  div.innerHTML = "<div style=\"font-size:13px;color:#666;margin-bottom:6px\">✍️ 手动回复患者（发送到群）</div>"
    + "<textarea id=\"triageManualReply\" placeholder=\"输入回复内容...\" style=\"width:100%;min-height:70px;border:1px solid #ddd;border-radius:8px;padding:10px 12px;font-size:13px;font-family:inherit;resize:vertical\"></textarea>"
    + "<button onclick=\"sendTriageManualReply()\" style=\"margin-top:8px;background:#07c160;color:#fff;border:none;border-radius:8px;padding:8px 20px;font-size:13px;cursor:pointer\">发送回复到群</button>";
  container.parentElement.appendChild(div);
}, 500);

async function sendTriageManualReply(){
  var ta = document.getElementById("triageManualReply");
  if(!ta || !ta.value.trim()){ alert("请输入回复内容"); return; }
  // 从页面 URL hash 或 DOM 获取 session id
  var cards = document.querySelectorAll("[data-confirm]");
  var sid = null;
  if(cards.length) sid = cards[0].getAttribute("data-confirm");
  if(!sid){
    // 尝试从当前高亮的会话列表项获取
    var active = document.querySelector(".on[data-id]");
    if(active) sid = active.getAttribute("data-id");
  }
  if(!sid){ alert("未找到当前分诊会话 ID"); return; }
  try {
    var res = await fetch("/api/admin/triage/"+sid+"/manual-reply", {
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body: JSON.stringify({text: ta.value.trim()})
    });
    var r = await res.json();
    if(r && r.ok){ ta.value=""; alert("✅ 已发送到群"); location.reload(); }
    else { alert("发送失败："+(r.error||"未知错误")); }
  } catch(e){ alert("发送异常："+e.message); }
}
</script>

