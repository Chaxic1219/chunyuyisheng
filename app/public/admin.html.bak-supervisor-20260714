.fq-dh b{font-size:15px}
.fq-dsub{font-size:12px;color:#888;margin-top:3px}
.fq-nodes{margin-top:12px;display:flex;flex-direction:column;gap:10px}
.fq-node{border-left:3px solid #e5e9ed;padding:2px 0 2px 12px}
.fq-node.due{border-left-color:#ff9f43}.fq-node.done,.fq-node.pushed{border-left-color:#07c160}
