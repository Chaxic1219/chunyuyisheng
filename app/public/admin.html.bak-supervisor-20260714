.risk{display:inline-flex;align-items:center;justify-content:center;border-radius:999px;padding:3px 9px;font-size:12px;font-weight:700;background:#e8f8ef;color:#07944b;white-space:nowrap}
.risk.medium{background:#fff5e6;color:#d97706}.risk.high{background:#fff0f0;color:#e03131}
.triage-thread{height:430px;overflow:auto;background:linear-gradient(#f7f8fa,#eef1f4);padding:16px}
.triage-thread::-webkit-scrollbar{width:0}
.tri-msg{max-width:78%;width:fit-content;margin-bottom:13px} /* fit-content：气泡收缩到内容宽度，短消息（如「你好」）不再撑满整行贴左 */
.tri-msg .who{font-size:11.5px;color:#8a8f98;margin-bottom:4px}
.tri-msg .txt{display:inline-block;max-width:100%;border-radius:10px;padding:10px 12px;font-size:14px;line-height:1.65;box-shadow:0 1px 2px rgba(0,0,0,.04);white-space:pre-wrap}
.tri-msg .send-state{font-size:11px;color:#a0a4aa;margin-top:4px}
.tri-msg.pat{margin-left:auto;text-align:right}.tri-msg.pat .who,.tri-msg.pat .send-state{text-align:right}
.tri-msg.pat .txt{background:#95ec69;color:#111}
.tri-msg.ai .txt{background:#fff;color:#222;border:1px solid #eef0f2}
.tri-msg.ai.draft .txt{background:#fffdf3;color:#7a5b00;border:1px dashed #e3c65b} /* 待审科普草稿：虚线+琥珀底，区别于已发给患者的安全话 */
.tri-msg.ai.draft .who{color:#b07a00}.tri-msg.ai.draft .send-state{color:#b07a00}
.tri-msg.human .txt{background:#eaf4ff;color:#154b83;border:1px solid #cfe6ff}
.tri-msg.sys{margin-left:auto;margin-right:auto;text-align:center;max-width:88%}
.tri-msg.sys .txt{background:rgba(0,0,0,.06);color:#666;font-size:12.5px}
.tri-attachments{display:flex;gap:8px;flex-wrap:wrap;margin-top:7px;justify-content:flex-start}
.tri-msg.pat .tri-attachments{justify-content:flex-end}
.tri-img{display:block;width:92px;color:inherit;text-decoration:none}
.tri-img img{width:92px;height:92px;border-radius:10px;object-fit:cover;background:#fff;border:1px solid rgba(0,0,0,.08);box-shadow:0 1px 2px rgba(0,0,0,.06)}
.tri-img span{display:block;margin-top:3px;font-size:11px;color:#7b8188;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;text-align:center}
.triage-composer{border-top:1px solid #edf0f2;padding:14px 16px calc(16px + env(safe-area-inset-bottom,0px));background:#fff;box-sizing:border-box}
.triage-composer label{display:block;font-size:12px;color:#666;margin-bottom:6px}
.triage-composer textarea{width:100%;min-height:92px;border:1px solid #dde3e8;border-radius:10px;padding:10px 12px;resize:vertical;font-family:inherit;font-size:13.5px;line-height:1.6;outline:none}
.triage-composer textarea:focus{border-color:#07c160;box-shadow:0 0 0 3px rgba(7,193,96,.09)}
.triage-btns{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
.triage-side{display:grid;gap:14px}
.triage-panel{margin-bottom:0}
.triage-panel h2{justify-content:space-between}
.judge-grid,.profile-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.judge-grid div,.profile-grid div{background:#f7f9fa;border:1px solid #edf0f2;border-radius:10px;padding:9px 10px;min-width:0}
.judge-grid span,.profile-grid span{display:block;color:#888;font-size:11.5px;margin-bottom:4px}
.judge-grid b,.profile-grid b{font-size:13px;color:#222;line-height:1.45;word-break:break-word}
.chips{display:flex;gap:6px;align-items:center}
.urg{display:inline-flex;align-items:center;border-radius:999px;padding:3px 9px;font-size:12px;font-weight:700;white-space:nowrap;background:#e8f8ef;color:#07944b}
.urg.soon{background:#fff5e6;color:#d97706}.urg.urgent{background:#fff0f0;color:#e03131}.urg.emergency{background:#fa5151;color:#fff}
/* 结构化病历卡 */
.intake-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
