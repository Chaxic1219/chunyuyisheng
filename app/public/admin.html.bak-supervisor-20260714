.fq-n-date{font-size:12px;color:#999;font-weight:400}
.fq-n-edu{font-size:12.5px;color:#444;line-height:1.6;margin-top:4px}
.fq-n-rem{font-size:12.5px;color:#777;line-height:1.6;margin-top:3px}
.fq-n-acts{display:flex;gap:8px;margin-top:7px}
.tag.due{background:#fff5e6;color:#d97706}.tag.done,.tag.pushed{background:#e7f7ee;color:#07a050}.tag.upcoming{background:#eef;color:#778}
/* 窄屏（含 iPad 横屏 1024 与手机）：内容区数据表横向滚动而非逐字挤压折行，列边界清晰 */
@media (max-width:1180px){
  .ops-grid,.community-grid{display:block}.ops-policy{grid-template-columns:1fr 1fr}.ops-kpis{grid-template-columns:1fr 1fr}
  .config-workbench{display:block}.config-live-panel{position:static;max-height:none;overflow:visible}
  .cfg-meta,.cfg-summary-grid{grid-template-columns:1fr}
  .cfg-workflow{grid-template-columns:1fr}
  .cfg-actionbar{display:block}.cfg-action-copy{border-left:none;padding-left:0;margin-top:10px}.cfg-action-buttons{margin-top:10px;justify-content:flex-start;flex-wrap:wrap}
  .community-head{display:block}.community-head .btn{margin-top:10px}
  .main table{display:block;overflow-x:auto;-webkit-overflow-scrolling:touch;white-space:nowrap}
  .main table::-webkit-scrollbar{height:6px}
  .main table::-webkit-scrollbar-thumb{background:#dde2e6;border-radius:3px}
}
@media (max-width:980px){ .fq-wrap{display:block}.fq-list{flex-direction:row;overflow-x:auto;max-height:none;margin-bottom:12px}.fq-item{min-width:200px;flex:0 0 auto} }
@media (max-width: 980px){
  /* 平板/手机：整页 100dvh 弹性链——顶栏+导航固定，内容区 .main 内部滚动（无 body 滚动、无魔法数字，自适应任意机型顶栏高度） */
  html,body{height:100%;overflow-x:hidden}
  #appView{display:flex;flex-direction:column;height:100dvh}
  .top{flex:0 0 auto;position:static;height:auto;min-height:0;display:grid;grid-template-columns:minmax(0,1fr) auto auto;align-items:center;padding:8px 10px;gap:8px}.top .brand{grid-column:1/-1;width:auto}.top .sp,.top .who,.top .help,.env-pill{display:none}.top select{width:100%;min-width:0;max-width:none}.top .logout{padding:6px 10px}
  .wrap{flex:1 1 auto;min-height:0;display:flex;flex-direction:column;max-width:100%;overflow:hidden}
  .nav{flex:0 0 auto;width:auto;display:flex;flex-wrap:nowrap;gap:8px;padding:8px 10px;overflow-x:auto;overflow-y:hidden;-webkit-overflow-scrolling:touch;border-right:none;border-bottom:1px solid #e8e8e8;scrollbar-gutter:auto}.nav-section{display:flex;flex:0 0 auto;gap:6px;margin:0}.nav-title{display:none}.nav button{white-space:nowrap;width:auto;flex:0 0 auto;margin-bottom:0;padding:8px 11px;height:36px}.nav-ico{display:none} /* 单行横向滑动，给小屏分诊区留出垂直空间 */
  .nav::-webkit-scrollbar{height:4px;width:0}.nav::-webkit-scrollbar-thumb{background:#d5dbe1;border-radius:999px}
  .card h2{flex-wrap:wrap} /* 窄屏标题与右侧按钮可换行，不被逐字挤断 */
  .main{flex:1 1 auto;min-height:0;overflow-y:auto;-webkit-overflow-scrolling:touch;padding:14px}
  .triage-head{display:block}.triage-head p{display:none}.triage-actions{justify-content:flex-start;margin-top:10px}
  .triage-mobile-tabs{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin:0 0 10px}
  .triage-mobile-tabs button{border:1px solid #e5e9ed;background:#fff;border-radius:10px;padding:8px 0;font-size:13px;color:#555}
  .triage-mobile-tabs button.on{background:#07c160;border-color:#07c160;color:#fff;font-weight:700}
  .triage-shell{display:block;min-width:0}.triage-side{display:block}.triage-chat,.triage-panel{display:none}
  .triage-shell.active-chat .triage-pane-chat,.triage-shell.active-judgement .triage-pane-judgement,.triage-shell.active-profile .triage-pane-profile,.triage-shell.active-history .triage-pane-history{display:block}
  .triage-shell.active-chat .triage-pane-chat{display:flex;flex-direction:column;height:clamp(500px,calc(100dvh - 284px),700px);min-height:0;overflow:hidden}
  .triage-session-strip,.triage-chat-top,.triage-composer{flex:0 0 auto}
  .triage-thread{flex:1 1 auto;height:auto;min-height:120px;max-height:none}.tri-msg{max-width:92%}.card{max-width:100%}.triage-panel{margin-bottom:0}
  .triage-composer{padding:10px 12px calc(14px + env(safe-area-inset-bottom,0px))}
  .triage-composer textarea{min-height:64px;max-height:108px}
  .triage-btns{margin-top:8px;padding-bottom:2px}
  .triage-shell.active-chat .triage-composer{position:static;z-index:auto;background:#fff;box-shadow:none} /* 发送框作为聊天卡底部区域参与 flex，不再覆盖消息 */
}
/* ===== 四端适配 ===== */
/* 桌面/笔记本（≥981）：分诊台限定在一屏内，对话区填满+内部滚动、发送框钉底，右侧整列内部滚动 */
