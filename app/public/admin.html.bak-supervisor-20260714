.session-chip{border:1px solid #e5e9ed;background:#fff;border-radius:10px;padding:8px 10px;min-width:150px;text-align:left;cursor:pointer;display:grid;grid-template-columns:auto 1fr;gap:4px 7px;align-items:center}
