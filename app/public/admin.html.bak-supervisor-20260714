<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>春雨医生社群 · 医助后台</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{font-family:-apple-system,"PingFang SC","Microsoft YaHei",sans-serif;background:#f0f2f5;color:#1a1a1a;font-size:14px;overflow:hidden}
a{color:#07c160}
.hidden{display:none!important}
/* 登录 */
.login{min-height:100vh;display:flex;align-items:center;justify-content:center}
.login .box{background:#fff;padding:36px 34px;border-radius:14px;box-shadow:0 12px 40px rgba(0,0,0,.12);width:340px}
.login h1{font-size:20px;margin-bottom:6px}
.login p{color:#888;font-size:12.5px;margin-bottom:20px}
.login input{width:100%;border:1px solid #e3e3e3;border-radius:8px;padding:11px 12px;font-size:14px;margin-bottom:12px;outline:none}
.login button{width:100%;background:#07c160;color:#fff;border:none;border-radius:8px;padding:12px;font-size:15px;cursor:pointer}
.login .err{color:#fa5151;font-size:12.5px;margin-top:8px;min-height:16px}
/* 布局 */
#appView{height:100vh;height:100dvh;display:flex;flex-direction:column;overflow:hidden}
.top{flex:0 0 54px;height:54px;background:#fff;border-bottom:1px solid #e8e8e8;display:flex;align-items:center;padding:0 20px;gap:16px;position:sticky;top:0;z-index:10}
.top .brand{font-weight:700}
.top .brand span{color:#07c160}
.top .sp{flex:1}
.top select{border:1px solid #ddd;border-radius:8px;padding:7px 10px;font-size:13px}
.top .who{color:#888;font-size:13px}
.top .logout{border:1px solid #ddd;background:#fff;border-radius:8px;padding:6px 12px;cursor:pointer;font-size:13px}
.wrap{flex:1 1 auto;min-height:0;display:flex;max-width:1860px;width:100%;margin:0 auto;overflow:hidden} /* 放宽主体上限，与满宽顶栏协调，避免宽屏左右大片留白（窄屏行为不变，≤980 走响应式） */
.nav{flex:0 0 190px;width:190px;align-self:stretch;padding:18px 12px;overflow-y:auto;overscroll-behavior:contain;background:#f0f2f5;border-right:1px solid #e7eaee;scrollbar-gutter:stable}
.nav::-webkit-scrollbar{width:6px}
.nav::-webkit-scrollbar-thumb{background:#d5dbe1;border-radius:999px}
.nav::-webkit-scrollbar-track{background:transparent}
.nav button{display:block;width:100%;text-align:left;border:none;background:none;padding:11px 14px;border-radius:8px;cursor:pointer;font-size:14px;color:#555;margin-bottom:3px}
.nav button.on{background:#e7f7ee;color:#07c160;font-weight:600}
.main{flex:1 1 auto;min-width:0;min-height:0;padding:18px 22px;overflow-y:auto;overscroll-behavior:contain;scrollbar-gutter:stable}
.main::-webkit-scrollbar{width:8px}
.main::-webkit-scrollbar-thumb{background:#cfd6dd;border-radius:999px}
.main::-webkit-scrollbar-track{background:transparent}
.card{background:#fff;border-radius:12px;padding:18px 20px;margin-bottom:16px;box-shadow:0 1px 3px rgba(0,0,0,.04)}
.card h2{font-size:16px;margin-bottom:14px;display:flex;align-items:center;gap:8px}
.card h2 .sub{font-weight:400;font-size:12.5px;color:#999}
.stats{display:flex;gap:14px;flex-wrap:wrap}
.stat{flex:1;min-width:120px;background:linear-gradient(135deg,#07c160,#0a9d6f);color:#fff;border-radius:12px;padding:16px 18px}
.stat .n{font-size:28px;font-weight:700}
.stat .l{font-size:12.5px;opacity:.9;margin-top:4px}
table{width:100%;border-collapse:collapse;font-size:13px}
th,td{text-align:left;padding:10px 8px;border-bottom:1px solid #f0f0f0;vertical-align:top}
th{color:#888;font-weight:500;font-size:12px}
.tag{display:inline-block;white-space:nowrap;background:#eef;color:#557;padding:1px 8px;border-radius:10px;font-size:11.5px}
.tag.green{background:#e7f7ee;color:#07a050}
.tag.warn{background:#fff7e6;color:#b8860b}
.tag.red{background:#fff0f0;color:#e03131}
.tag.blue{background:#eaf4ff;color:#1769c0}
.btn{border:none;border-radius:7px;padding:6px 12px;cursor:pointer;font-size:12.5px;white-space:nowrap}
.btn.p{background:#07c160;color:#fff}
.btn.g{background:#f0f2f5;color:#444}
.btn.d{background:#fff0f0;color:#fa5151}
.btn.s{padding:4px 9px;font-size:12px}
.toolbar{display:flex;gap:8px;margin-bottom:14px;flex-wrap:wrap;align-items:center}
.toolbar select,.toolbar input{border:1px solid #ddd;border-radius:8px;padding:7px 10px;font-size:13px}
.pill{border:1px solid #ddd;background:#fff;border-radius:16px;padding:5px 13px;font-size:12.5px;cursor:pointer}
.pill.on{background:#07c160;border-color:#07c160;color:#fff}
.empty{color:#aaa;text-align:center;padding:30px;font-size:13px}
/* 主动提醒：导航角标 + 提醒列表 + 跳转高亮 */
.nav-badge{display:inline-block;min-width:17px;height:17px;line-height:17px;text-align:center;background:#fa5151;color:#fff;border-radius:9px;font-size:11px;font-weight:700;padding:0 5px;margin-left:6px;vertical-align:middle}
.rem-list{display:flex;flex-direction:column;gap:8px}
.rem-item{display:flex;align-items:center;gap:10px;width:100%;text-align:left;border:1px solid #edf0f2;background:#fbfcfd;border-radius:10px;padding:9px 12px;cursor:pointer;font-size:13px}
.rem-item:hover{border-color:#07c160;background:#effbf4}
.rem-item .rem-sum{flex:1;color:#3f4650;line-height:1.5;white-space:normal;word-break:break-word}
.rem-item .rem-time{color:#8b95a1;font-size:11.5px;white-space:nowrap}
.row-flash td{animation:rowFlash 1.8s ease-out}
@keyframes rowFlash{0%{background:#fff3cd}60%{background:#fff7e6}100%{background:transparent}}
/* 弹层表单 */
.modal{position:fixed;inset:0;background:rgba(0,0,0,.4);display:flex;align-items:center;justify-content:center;z-index:50}
.modal .m{background:#fff;border-radius:12px;width:560px;max-width:92vw;max-height:88vh;overflow:auto;padding:22px}
.modal h3{font-size:16px;margin-bottom:14px}
.fld{margin-bottom:12px}
.fld label{display:block;font-size:12.5px;color:#666;margin-bottom:5px}
.fld input,.fld select,.fld textarea{width:100%;border:1px solid #ddd;border-radius:8px;padding:9px 11px;font-size:13px;outline:none;font-family:inherit}
.fld textarea{min-height:120px;resize:vertical;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12px;line-height:1.5}
.fld .hint{font-size:11.5px;color:#aaa;margin-top:4px}
.m-actions{display:flex;gap:10px;justify-content:flex-end;margin-top:8px}
.kv{font-size:13px;line-height:1.9}
.kv b{color:#555;display:inline-block;min-width:84px}
/* 运营策略台 */
.ops-hero h2{margin-bottom:6px}.ops-hero p{color:#666;font-size:13px;line-height:1.7;max-width:980px}
.ops-head{display:flex;justify-content:space-between;gap:14px;align-items:flex-start;margin-bottom:14px}
.ops-kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin:12px 0 16px}
.ops-kpi{border:1px solid #edf0f2;background:#fbfcfd;border-radius:10px;padding:12px 13px;min-width:0}
.ops-kpi span{display:block;color:#888;font-size:12px;margin-bottom:5px}
.ops-kpi b{display:block;font-size:22px;line-height:1.2;color:#17202a;word-break:break-word}
.ops-kpi small{display:block;color:#8b95a1;font-size:11.5px;margin-top:6px;line-height:1.45}
.ops-policy{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
.ops-policy-item{border:1px solid #edf0f2;background:#fff;border-radius:10px;padding:11px 12px;min-width:0}
.ops-policy-item span{display:block;color:#07a050;font-size:12px;font-weight:700;margin-bottom:6px}
.ops-policy-item p{color:#3f4650;font-size:12.5px;line-height:1.65;word-break:break-word}
.ops-grid{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(360px,.9fr);gap:16px;align-items:start}
.ops-section{min-width:0}.ops-section h2{flex-wrap:wrap}
.ops-muted{color:#8b95a1;font-size:12px;line-height:1.55;margin-top:4px;max-width:620px;white-space:normal;word-break:break-word}
.ops-mode{display:inline-flex;align-items:center;white-space:nowrap;border-radius:999px;padding:2px 9px;font-size:11.5px;font-weight:700}
.ops-mode.pre{background:#e7f7ee;color:#07944b}.ops-mode.semi{background:#eef2ff;color:#4f46e5}.ops-mode.live{background:#fff5e6;color:#d97706}
.cfg-explain{border:1px solid #dff3e8;background:#f6fffa;border-radius:12px;padding:12px 14px;margin-bottom:14px;color:#40504a;font-size:13px;line-height:1.7}
.cfg-explain b{display:block;color:#078942;font-size:14px;margin-bottom:2px}.cfg-explain span{display:block;color:#5d6a64}
.cfg-explain.danger{border-color:#ffd7d7;background:#fff8f8}.cfg-explain.danger b{color:#d93025}
.cfg-workflow{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin:0 0 12px}
.cfg-step{border:1px solid #edf0f2;background:#fbfcfd;border-radius:12px;padding:11px 12px;color:#59636e;font-size:12.5px;line-height:1.55}
.cfg-step b{display:block;color:#16202a;font-size:13.5px;margin-bottom:4px}.cfg-step.on{border-color:#b9ebd0;background:#f4fff8}
.cfg-actionbar{position:sticky;bottom:12px;z-index:6;display:flex;align-items:center;justify-content:space-between;gap:12px;border:1px solid #dff3e8;background:rgba(246,255,250,.97);backdrop-filter:blur(8px);border-radius:12px;padding:10px 12px;margin:14px 0 0;box-shadow:0 -6px 22px rgba(18,32,46,.08)}
.cfg-action-copy{min-width:0}.cfg-action-copy b{display:block;color:#078942;font-size:14px;margin-bottom:3px}.cfg-action-copy b.dirty{color:#c26a00}.cfg-action-copy b.saved{color:#078942}.cfg-action-copy span{display:block;color:#52606d;font-size:12.5px;line-height:1.55;word-break:break-word}
.cfg-action-buttons{flex:0 0 auto;margin:0}.cfg-action-buttons .btn{white-space:nowrap}
.cfg-msg{margin-bottom:12px}
.cfg-cards{display:grid;grid-template-columns:1fr;gap:12px}
.cfg-card{border:1px solid #e8edf0;background:#fff;border-radius:12px;padding:13px 14px;box-shadow:0 1px 2px rgba(18,32,46,.03)}
.cfg-card-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;margin-bottom:10px}
.cfg-card-head b{font-size:15px;color:#16202a}.cfg-card-head p{font-size:12.5px;color:#6f7b86;line-height:1.55;margin-top:3px}
.cfg-status{flex:0 0 auto;border-radius:999px;background:#eef2f5;color:#52606d;padding:3px 9px;font-size:11.5px;font-weight:700}
.cfg-status.ok{background:#e7f7ee;color:#07944b}.cfg-status.safe{background:#edf7ff;color:#1976d2}.cfg-status.semi{background:#fff5e6;color:#d97706}.cfg-status.danger{background:#fff0f0;color:#d93025}
.cfg-meta{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-bottom:10px}
.cfg-meta span{border:1px solid #edf0f2;background:#fbfcfd;border-radius:9px;padding:8px 9px;color:#52606d;font-size:12px;line-height:1.5;min-width:0}
.cfg-meta b{display:block;color:#07a050;font-size:11.5px;margin-bottom:3px}
.cfg-vars{margin:0 0 10px;color:#7b8794;font-size:12px}
.cfg-vars summary{display:inline-flex;align-items:center;cursor:pointer;color:#52606d;background:#f7f9fa;border:1px solid #edf0f2;border-radius:999px;padding:3px 9px;font-size:12px;font-weight:700}
.cfg-vars:not([open]) .cfg-var-body{display:none}
.cfg-var-body{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
.cfg-var-body span{display:inline-flex;align-items:center;gap:5px;background:#f7fbf8;border:1px solid #dcefe5;color:#52606d;border-radius:999px;padding:3px 8px}
.cfg-var-body b{font-size:11.5px;color:#078942}
.cfg-vars code{font-family:ui-monospace,Consolas,monospace;color:#078942}
.cfg-field{width:100%;min-height:112px;border:1px solid #dfe5e8;border-radius:10px;padding:10px 11px;font-size:13px;line-height:1.65;font-family:inherit;resize:vertical;outline:none;background:#fff}
.cfg-field:focus{border-color:#07c160;box-shadow:0 0 0 3px rgba(7,193,96,.10)}
.cfg-field[readonly]{background:#f7f9fa;color:#7b8794}
.cfg-readonly-cards{gap:10px}
.cfg-read-card{background:#fbfcfd}
.cfg-read-value{white-space:pre-wrap;word-break:break-word;background:#fff;border:1px solid #edf0f2;border-radius:10px;padding:10px 11px;color:#27323c;font-size:13px;line-height:1.7;max-height:170px;overflow:auto}
.cfg-empty-value{display:block;color:#697684}.cfg-empty-value b{display:inline-block;color:#c26a00;margin-right:6px}
.cfg-published-note{border:1px solid #dff3e8;background:#f6fffa;border-radius:12px;padding:11px 13px;margin-bottom:12px;font-size:13px;line-height:1.65;color:#40504a}
.cfg-published-note b{display:block;color:#078942;margin-bottom:2px}.cfg-published-note.warn{border-color:#ffe5bd;background:#fffaf0}.cfg-published-note.warn b{color:#c26a00}
.cfg-json-view{white-space:pre-wrap;word-break:break-word;background:#f7f9fa;border:1px solid #edf0f2;border-radius:10px;padding:12px;max-height:300px;overflow:auto;font-size:12px;font-family:ui-monospace,Consolas,monospace}
.cfg-advanced{margin:14px 0;border:1px dashed #dfe5e8;border-radius:12px;padding:10px 12px;background:#fbfcfd}
.cfg-advanced summary{cursor:pointer;color:#52606d;font-size:13px;font-weight:700}
.cfg-summary-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-bottom:14px}
/* ===== 医助后台 UI refresh：产品化外壳 + 运营工作台 ===== */
:root{
  --cy-green:#08bf6f;
  --cy-green-strong:#05a85d;
  --cy-green-soft:#eafaf2;
  --cy-ink:#102033;
  --cy-muted:#667789;
  --cy-line:#e7edf3;
  --cy-bg:#f5f7fa;
  --cy-card:#fff;
  --cy-shadow:0 10px 30px rgba(15,38,66,.06);
}
body{background:var(--cy-bg);color:var(--cy-ink);font-size:14px}
a{color:var(--cy-green-strong)}
.login{background:radial-gradient(circle at 48% 28%,#fff 0,#f5f8fb 42%,#edf2f6 100%)}
.login .box{border:1px solid var(--cy-line);box-shadow:0 22px 70px rgba(16,32,51,.12)}
.login h1{font-size:22px;color:var(--cy-ink)}.login h1::after{content:"";display:block;width:48px;height:4px;background:var(--cy-green);border-radius:4px;margin-top:10px}
.login button{background:var(--cy-green)}
.top{height:66px;flex-basis:66px;border-bottom:1px solid var(--cy-line);box-shadow:0 1px 0 rgba(16,32,51,.02);padding:0 26px;background:rgba(255,255,255,.96);gap:18px}
.top .brand{display:flex;align-items:center;gap:10px;min-width:180px;font-weight:700;color:var(--cy-ink)}
.top .brand b{display:block;font-size:18px;letter-spacing:.2px}.top .brand small{display:block;color:#7a8897;font-size:11.5px;font-weight:500;margin-top:1px}
.brand-mark{display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:10px;background:linear-gradient(135deg,#0fcf7a,#06a85f);color:#fff!important;font-weight:800;box-shadow:0 8px 18px rgba(8,191,111,.22)}
.top select{height:38px;min-width:230px;border-color:#dfe7ef;border-radius:10px;color:#1b2a3a;background:#fff;padding:0 38px 0 12px}
.top .btn.g{height:34px;border:1px solid #e4ebf1;background:#f7fafc;border-radius:10px;color:#405065}
.env-pill{display:inline-flex;align-items:center;gap:8px;height:32px;border:1px solid #e3f4eb;background:#f7fffb;color:#466054;border-radius:10px;padding:0 13px;font-size:12.5px;white-space:nowrap}
.env-pill span,.env-pill i{display:inline-block;width:7px;height:7px;background:var(--cy-green);border-radius:50%;box-shadow:0 0 0 3px rgba(8,191,111,.12)}.env-pill i{box-shadow:none;width:5px;height:5px}
.top .help{color:#5f6d7a;font-size:13px;white-space:nowrap}.top .who{color:#415166;font-size:14px}.top .logout{height:34px;border-color:#dfe7ef;border-radius:10px;color:#1f2d3d}
.wrap{max-width:none;background:var(--cy-bg)}
.nav{flex:0 0 208px;width:208px;background:#f8fafc;border-right:1px solid var(--cy-line);padding:18px 12px 16px}
.nav-section{margin-bottom:18px}.nav-section:last-child{margin-bottom:0}
.nav-title{font-size:12px;color:#92a0af;line-height:1;margin:0 10px 8px}
.nav button{display:flex;align-items:center;gap:10px;height:40px;margin:0 0 4px;border-radius:10px;padding:0 12px;color:#465568;font-size:14px;transition:background .15s ease,color .15s ease,box-shadow .15s ease}
.nav button:hover{background:#eef6f1;color:#12864f}.nav button.on{background:var(--cy-green-soft);color:var(--cy-green-strong);box-shadow:inset 3px 0 0 var(--cy-green);font-weight:700}
.nav-ico{display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:7px;background:#eef3f8;color:#60758a;font-size:11px;font-weight:800;letter-spacing:0}.nav button.on .nav-ico{background:#d8f5e6;color:var(--cy-green-strong)}
.nav-label{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.nav-badge{margin-left:auto;background:#ff5f5f}
.main{padding:20px 22px;background:var(--cy-bg)}
.card{border:1px solid var(--cy-line);border-radius:14px;box-shadow:var(--cy-shadow);padding:18px 20px}
.card h2{color:var(--cy-ink);font-size:17px}.card h2 .sub{color:#8190a0}
.btn{border-radius:9px;padding:7px 13px;font-weight:600}.btn.p{background:var(--cy-green);color:#fff}.btn.p:hover{background:var(--cy-green-strong)}.btn.g{background:#f4f7fa;border:1px solid #e2eaf1}.btn.d{background:#fff4f2;color:#e34d3d;border:1px solid #ffd9d3}
.pill,.config-tabs button{transition:all .15s ease}
.config-page{display:block;min-width:0}
.config-tabs{display:flex;gap:28px;align-items:center;background:#fff;border:1px solid var(--cy-line);border-radius:14px 14px 0 0;padding:0 18px;height:52px;box-shadow:0 8px 24px rgba(16,32,51,.04);overflow-x:auto;overflow-y:hidden;scrollbar-width:none}
.config-tabs::-webkit-scrollbar{height:0}
.config-tabs button{height:52px;border:none;background:transparent;color:#516174;font-size:14px;cursor:pointer;border-bottom:2px solid transparent;padding:0 3px;position:relative;white-space:nowrap;flex:0 0 auto}
.config-tabs button.on{color:var(--cy-green-strong);font-weight:800;border-bottom-color:var(--cy-green)}.config-tabs button span{margin-left:6px;background:#fff5e6;color:#c26a00;border-radius:999px;padding:1px 7px;font-size:11px}
.cfg-actionbar{position:static;z-index:auto;display:grid;grid-template-columns:minmax(0,1fr) auto minmax(220px,.36fr);align-items:center;gap:18px;border:1px solid var(--cy-line);border-top:none;background:#fff;border-radius:0 0 14px 14px;margin:0 0 12px;padding:14px 18px;box-shadow:var(--cy-shadow)}
.cfg-action-title{font-size:18px;font-weight:800;color:var(--cy-ink)}.cfg-action-title span{font-size:13px;color:#7b8794;font-weight:400;margin-left:8px}
.cfg-state-line{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}.cfg-state-line span{display:inline-flex;align-items:center;background:#f5f9fc;border:1px solid #e6edf4;border-radius:999px;color:#607080;font-size:12px;padding:3px 9px}
.cfg-action-copy{padding-left:16px;border-left:1px solid #eef2f5}.cfg-action-copy b{font-size:13.5px}.cfg-action-copy span{font-size:12px;color:#7b8794}
.cfg-action-buttons{margin:0;justify-content:flex-end;flex-wrap:nowrap}.cfg-action-buttons .btn{height:36px}
.cfg-msg{border-color:#e6edf4;background:#fbfcfd;margin-bottom:14px;color:#536273}
.config-workbench{grid-template-columns:minmax(540px,1.08fr) minmax(430px,.92fr);gap:18px;align-items:start}
.config-editor,.config-live-panel{margin-bottom:16px}.config-live-panel{position:sticky;top:18px;max-height:calc(100vh - 116px);overflow:auto}
.config-live-panel::-webkit-scrollbar{width:6px}.config-live-panel::-webkit-scrollbar-thumb{background:#d7e0e8;border-radius:999px}
.cfg-workflow{grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.cfg-step{border-color:#e8eef4;background:#f9fbfd}.cfg-step.on{border-color:#c8f0d9;background:#f4fff8}
.cfg-explain{border-color:#dff4e8;background:#f8fffb}
.cfg-card{border-color:#e6edf4;border-radius:13px;padding:14px 16px;box-shadow:0 4px 16px rgba(16,32,51,.035)}
.cfg-card-head b{font-size:15.5px}.cfg-status{background:#edf3f7}.cfg-status.ok{background:#def8ea}.cfg-status.semi{background:#fff2de}
